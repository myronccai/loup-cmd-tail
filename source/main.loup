@mode(host.dual)

# tail: entry point. Keep this file thin: all behaviour lives in
# cli.app.run so that tests can call it with an argument list.
#
# Runtime: host.dual. main() gets the command line from runtime.args(). The
# same source runs two ways: `make run` interprets it with `loup run
# source/main.loup`, and `make build` compiles it with the rest of source/
# into the native binary build/tail, which `make e2e` and CI then exercise.
# Only the native binary can follow files (-f) or write -c output that is
# not valid UTF-8, because both call C (see cli/output.loup); `loup run`
# stops there.

from cli.app import (run);

func main(): int {
    return run(runtime.args());
}
