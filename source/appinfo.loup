@mode(host.dual)

# Application identity for tail: name, version, summary and exit statuses.
# Keep APP_NAME and APP_VERSION in step with `name` and `version` in
# package.lppkg.
#
# Runtime: host.dual. Constants only. Compiled into build/tail by `make
# build`; `loup run source/main.loup` interprets the same code.

pub const APP_NAME: string = "tail";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Print the last part of files (a Loup recreation of GNU tail).";

# Exit statuses returned by main(). GNU tail reports usage errors with
# status 1, the same as a missing file.
pub const EXIT_OK: int = 0;
pub const EXIT_FAILURE: int = 1;
pub const EXIT_USAGE: int = 1;
