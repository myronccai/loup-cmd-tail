@mode(host.dual)

# Byte-level I/O through C, for what Loup 1.26.0 cannot do itself. Only a
# native build can call C (`loup run` stops with "unsupported instruction").
#
# - Writing bytes: `print` writes a string's bytes as they are, but a Loup
#   string can only be built from whole UTF-8 characters, so a slice of
#   bytes that ends inside a character (or binary data) has no string form:
#   `bytes.decode()` would replace the broken sequence with U+FFFD. Such
#   output goes through putchar.
# - Following a file (-f): io.fs has no stat() or seek, and in a native build
#   every `readBytes` stays allocated, so re-reading a growing file at each
#   check would use the file's size in memory per check. C's stdio gives the
#   size (fseek/ftell) and reads just the new bytes.

extern native "c" func putchar(c: int32): int32;
extern native "c" func fflush(stream: int): int32;
extern native "c" func access(path: string, mode: int32): int32;
extern native "c" func fopen(path: string, mode: string): NativeHandle;
extern native "c" func fseek(f: NativeHandle, offset: int, whence: int32): int32;
extern native "c" func ftell(f: NativeHandle): int;
extern native "c" func fgetc(f: NativeHandle): int32;
extern native "c" func fclose(f: NativeHandle): int32;

const R_OK: int = 4;
const SEEK_SET: int = 0;
const SEEK_END: int = 2;

# Whether `data` is well-formed UTF-8 (no overlong forms, surrogates or
# code points above U+10FFFF), so that `decode()` returns it unchanged.
pub func is_utf8(data: bytes): bool {
    let n = data.len();
    var i = 0;
    while (i < n) {
        let b = data[i];
        if (b < 0x80) {
            i += 1;
            continue;
        }
        var need = 0;
        var lo = 0x80;
        var hi = 0xBF;
        if (b >= 0xC2 and b <= 0xDF) {
            need = 1;
        } else if (b == 0xE0) {
            need = 2;
            lo = 0xA0;
        } else if (b == 0xED) {
            need = 2;
            hi = 0x9F;
        } else if (b >= 0xE1 and b <= 0xEF) {
            need = 2;
        } else if (b == 0xF0) {
            need = 3;
            lo = 0x90;
        } else if (b == 0xF4) {
            need = 3;
            hi = 0x8F;
        } else if (b >= 0xF1 and b <= 0xF3) {
            need = 3;
        } else {
            return false;
        }
        if (i + need >= n) {
            return false;
        }
        for (k in 1..need + 1) {
            let c = data[i + k];
            if (c < lo or c > hi) {
                return false;
            }
            lo = 0x80;
            hi = 0xBF;
        }
        i += need + 1;
    }
    return true;
}

# Writes `data` to standard output exactly.
pub func print_bytes(data: bytes): void {
    if (is_utf8(data)) {
        print(data.decode());
        return;
    }
    for (i in 0..data.len()) {
        putchar(data[i] as int32);
    }
    # Flush C's buffer (fflush(NULL)) so later prints stay in order.
    fflush(0);
}

# The size of the file at `path` in bytes, or -1 if it cannot be read.
pub func file_size(path: string): int {
    if (access(path, R_OK as int32) != (0 as int32)) {
        return -1;
    }
    let f = fopen(path, "rb");
    fseek(f, 0, SEEK_END as int32);
    let size = ftell(f);
    fclose(f);
    return size;
}

# Copies the file at `path` from byte `offset` to its end onto standard
# output, and returns the offset reached.
pub func copy_from(path: string, offset: int): int {
    if (access(path, R_OK as int32) != (0 as int32)) {
        return offset;
    }
    let f = fopen(path, "rb");
    fseek(f, offset, SEEK_SET as int32);
    var reached = offset;
    var c = fgetc(f);
    while (c >= (0 as int32)) {
        putchar(c);
        reached += 1;
        c = fgetc(f);
    }
    fclose(f);
    fflush(0);
    return reached;
}
